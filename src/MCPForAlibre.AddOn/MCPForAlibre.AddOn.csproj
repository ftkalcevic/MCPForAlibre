<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MCPForAlibre.AddOn</AssemblyName>
    <RootNamespace>MCPForAlibre.AddOn</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AlibreProgram Condition="'$(AlibreProgram)' == ''">C:\Program Files\Alibre Design 27.0.1.27039\Program</AlibreProgram>
  </PropertyGroup>

  <ItemGroup>
    <!-- Alibre's own interop assemblies: referenced, never copied (Alibre has loaded them already). -->
    <Reference Include="AlibreX">
      <HintPath>$(AlibreProgram)\AlibreX.dll</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="AlibreAddOn">
      <HintPath>$(AlibreProgram)\AlibreAddOn.dll</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="System.Core" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <None Update="MCPForAlibre.adc" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\MCPForAlibre.Server\MCPForAlibre.ico" Link="MCPForAlibre.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
